# Base URL of the Baro backend (no trailing slash).
# The deployed instance:
NEXT_PUBLIC_API_URL=https://baro-2fl1.onrender.com

# Point it at a local backend instead when developing against one, e.g.:
# NEXT_PUBLIC_API_URL=http://localhost:8080

# Base URL for the expense-policy endpoints (/api/policies/*).
# Leave EMPTY to use the temporary stub in app/api/policies/, which returns a
# fixed example ruleset and keeps state only in memory.
# Set it once the real service implements the contract in types/policy.ts:
# NEXT_PUBLIC_POLICY_API_URL=https://baro-2fl1.onrender.com
NEXT_PUBLIC_POLICY_API_URL=
